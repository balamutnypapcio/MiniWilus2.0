// --- Hardware Configuration ---

// Configuration array for ToF sensors (Pin mapping)
// UWAGA: Używamy typu zdefiniowanego w tof_sensors.h
ToF_Config_t sensor_configs[TOTAL_SENSOR_COUNT] = {
    { XSHUT1_GPIO_Port, XSHUT1_Pin, &hi2c1 },  // Front Right (0)
    { XSHUT2_GPIO_Port, XSHUT2_Pin, &hi2c1 },  // Side Right  (1)
    { XSHUT3_GPIO_Port, XSHUT3_Pin, &hi2c2 },  // Side Left   (2)
    { XSHUT4_GPIO_Port, XSHUT4_Pin, &hi2c2 }   // Front Left  (3)
};

// Interrupt flags for ToF sensors
volatile bool g_sensor_data_ready[TOTAL_SENSOR_COUNT] = {false};

// --- Data Buffers ---

// Buffer for ToF distance measurements [mm]
uint16_t tof_distances[TOTAL_SENSOR_COUNT];

// Buffer for Line sensors (DMA Circular)
volatile uint16_t adc_line_values[3]; 

extern TIM_HandleTypeDef htim2;  // Timer for IR (us)
/* USER CODE END PV */
/* USER CODE END PV */

/* Private function prototypes -----------------------------------------------*/
void SystemClock_Config(void);
/* USER CODE BEGIN PFP */

/* USER CODE END PFP */

/* Private user code ---------------------------------------------------------*/
/* USER CODE BEGIN 0 */

/**
 * @brief Helper function to check flags and read data from ToF sensors.
 *        Called in main loop.
 */
void ProcessSensorFlags(void) {
    for(int i = 0; i < TOTAL_SENSOR_COUNT; i++) {
        if(g_sensor_data_ready[i]) {
            g_sensor_data_ready[i] = false;
            tof_distances[i] = ToF_ReadSingle(i); 
        }
    }
}

/**
 * @brief Simple status LED update based on object detection
 */
void UpdateDebugLED(void) {
    bool objectDetected = false;
    for(int i=0; i<TOTAL_SENSOR_COUNT; i++) {
        if(tof_distances[i] < 200 && tof_distances[i] > 10) objectDetected = true;
    }
    HAL_GPIO_WritePin(LED_GPIO_Port, LED_Pin, objectDetected ? GPIO_PIN_SET : GPIO_PIN_RESET);
}

/* USER CODE END 0 */

/**
  * @brief  The application entry point.
  * @retval int
  */
int main(void)
{

  /* USER CODE BEGIN 1 */

  /* USER CODE END 1 */

  /* MCU Configuration--------------------------------------------------------*/

  /* Reset of all peripherals, Initializes the Flash interface and the Systick. */
  HAL_Init();

  /* USER CODE BEGIN Init */

  /* USER CODE END Init */

  /* Configure the system clock */
  SystemClock_Config();

  /* USER CODE BEGIN SysInit */

  /* USER CODE END SysInit */

  /* Initialize all configured peripherals */
  MX_GPIO_Init();
  MX_DMA_Init();
  MX_I2C2_Init();
  MX_I2C1_Init();
  MX_TIM3_Init();
  MX_ADC1_Init();
  MX_TIM2_Init();
  /* USER CODE BEGIN 2 */
  
  // 1. Initialize Hardware Helpers
  HAL_TIM_Base_Start(&htim2); // For IR timing
  Motors_Init();
  IR_Init();
  ToF_InitAll(sensor_configs, TOTAL_SENSOR_COUNT); 
  ToF_ClearAllInterrupts();
  for(int i=0; i<TOTAL_SENSOR_COUNT; i++) g_sensor_data_ready[i] = false;
  HAL_ADC_Start_DMA(&hadc1, (uint32_t*)adc_line_values, 3);
  Logic_Init();

  HAL_Delay(500);

  /* USER CODE END 2 */

  /* Infinite loop */
  /* USER CODE BEGIN WHILE */
  while (1)
  {
    /* USER CODE END WHILE */

    /* USER CODE BEGIN 3 */
    
    // --- Step 1: Safety Check (IR Remote) ---
    if (!IR_IsRobotEnabled()) {
        Motors_Stop();
        HAL_GPIO_WritePin(LED_GPIO_Port, LED_Pin, GPIO_PIN_RESET);
        continue;
    }
    ProcessSensorFlags();
    UpdateDebugLED();
    Logic_Update((uint16_t*)adc_line_values, tof_distances);
    
   }
  /* USER CODE END 3 */
}

/**
  * @brief System Clock Configuration
  * @retval None
  */
void SystemClock_Config(void)
{
  RCC_OscInitTypeDef RCC_OscInitStruct = {0};
  RCC_ClkInitTypeDef RCC_ClkInitStruct = {0};

  /** Configure the main internal regulator output voltage
  */
  HAL_PWREx_ControlVoltageScaling(PWR_REGULATOR_VOLTAGE_SCALE1_BOOST);

  /** Initializes the RCC Oscillators according to the specified parameters
  * in the RCC_OscInitTypeDef structure.
  */
  RCC_OscInitStruct.OscillatorType = RCC_OSCILLATORTYPE_HSI;
  RCC_OscInitStruct.HSIState = RCC_HSI_ON;
  RCC_OscInitStruct.HSICalibrationValue = RCC_HSICALIBRATION_DEFAULT;
  RCC_OscInitStruct.PLL.PLLState = RCC_PLL_ON;
  RCC_OscInitStruct.PLL.PLLSource = RCC_PLLSOURCE_HSI;
  RCC_OscInitStruct.PLL.PLLM = RCC_PLLM_DIV4;
  RCC_OscInitStruct.PLL.PLLN = 85;
  RCC_OscInitStruct.PLL.PLLP = RCC_PLLP_DIV2;
  RCC_OscInitStruct.PLL.PLLQ = RCC_PLLQ_DIV2;
  RCC_OscInitStruct.PLL.PLLR = RCC_PLLR_DIV2;
  if (HAL_RCC_OscConfig(&RCC_OscInitStruct) != HAL_OK)
  {
    Error_Handler();
  }

  /** Initializes the CPU, AHB and APB buses clocks
  */
  RCC_ClkInitStruct.ClockType = RCC_CLOCKTYPE_HCLK|RCC_CLOCKTYPE_SYSCLK
                              |RCC_CLOCKTYPE_PCLK1|RCC_CLOCKTYPE_PCLK2;
  RCC_ClkInitStruct.SYSCLKSource = RCC_SYSCLKSOURCE_PLLCLK;
  RCC_ClkInitStruct.AHBCLKDivider = RCC_SYSCLK_DIV1;
  RCC_ClkInitStruct.APB1CLKDivider = RCC_HCLK_DIV1;
  RCC_ClkInitStruct.APB2CLKDivider = RCC_HCLK_DIV1;

  if (HAL_RCC_ClockConfig(&RCC_ClkInitStruct, FLASH_LATENCY_4) != HAL_OK)
  {
    Error_Handler();
  }
}

/* USER CODE BEGIN 4 */

void HAL_GPIO_EXTI_Callback(uint16_t GPIO_Pin){

  // Check IR Receiver interrupt
  if (GPIO_Pin == STARTER_Pin) {
        IR_GPIO_Callback();
        return;
  }
  
  // Check ToF Sensors interrupts
  // Map GPIO pins to sensor indices
  switch (GPIO_Pin)
  {
    case EXTI1_Pin:
      g_sensor_data_ready[0] = true;
      break;
    case EXTI2_Pin:
      g_sensor_data_ready[1] = true;
      break;
    case EXTI3_Pin:
      g_sensor_data_ready[2] = true;
      break;
    case EXTI4_Pin:
      g_sensor_data_ready[3] = true;
      break;
    default:
      break;
  }
}

void HAL_I2C_ErrorCallback(I2C_HandleTypeDef *hi2c) {
    // I2C error - reset
    NVIC_SystemReset();
}

/* USER CODE END 4 */

